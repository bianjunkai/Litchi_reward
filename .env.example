# Optional bootstrap PIN (6–12 digits). Leave empty to set it in the parent screen.
# Once set, change the PIN in the parent console; this variable never overwrites it.
PARENT_PIN=

# NAS web port. Development server still defaults to 8080.
WEB_PORT=18736

# Optional HTTP proxy for pip/npm during Docker builds. Empty means direct access.
# Example: BUILD_PROXY=http://proxy-host:port
# HTTPS_PROXY uses the same http:// proxy URL (HTTPS destinations use CONNECT).
BUILD_PROXY=
BUILD_NO_PROXY=localhost,127.0.0.1,api,web
